{
  // Tipos de todo el monorepo JS/TS (npm run tipos). Fuera: packages/viewer/covillaf3d/** (depende de la carpeta de COVILLAF 3D,
  // tiene su tsconfig.covillaf3d.json) y lo que se consume por ruta de COVILLAF DESIGN (se comprueba allí).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Lo que la interfaz consume de COVILLAF DESIGN por alias (packages/ui/vite.config.ts): el mismo destino para los tipos.
    "paths": {
      "@covillaf-design/ui/protocolo": ["../07.34 COVILLAF DESIGN/packages/ui/src/protocolo/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "packages/ui/vite.config.ts",
    "apps/desktop/**/*"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "packages/viewer/covillaf3d/**",
    "packages/ui/src/visor.ts"
  ]
}
